{
  "name": "sportreserve-tasks-api",
  "version": "1.0.0",
  "description": "API de gestión de tareas con autenticación y roles para el caso SportReserve.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:docker": "node src/db/migrate.js && node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup": "npm run db:create:test && npm run db:migrate:test",
    "lint": "eslint .",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:create:test": "node src/db/createDatabase.js",
    "db:check": "node src/config/testConnection.js"
  },
  "keywords": [
    "node",
    "express",
    "postgresql",
    "jwt",
    "rbac",
    "tasks"
  ],
  "author": "Equipo SportReserve Tasks",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
