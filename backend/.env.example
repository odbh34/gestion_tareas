# Entorno
NODE_ENV=development
PORT=3000

# PostgreSQL local (sin Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sportreserve
POSTGRES_USER=sportreserve_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB_TEST=sportreserve_test

# Alternativa: cadena de conexión completa (Neon, Supabase, Docker, etc.)
# DATABASE_URL=postgresql://usuario:password@host:5432/base

# Seguridad
# Genera uno con: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=2h
JWT_MAX_AGE_MS=7200000
COOKIE_NAME=sr_token
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
TRUST_PROXY=false
BCRYPT_ROUNDS=12

# Bloqueo progresivo por cuenta (segundos)
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=60
LOCKOUT_MAX_SECONDS=900

# Límites de solicitudes
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300

# Credenciales del seed (solo desarrollo)
SEED_STUDENT_PASSWORD=Demo12345!
SEED_TEACHER_PASSWORD=Demo12345!
SEED_ADMIN_PASSWORD=Demo12345!
