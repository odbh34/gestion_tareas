# URL del backend para el proxy de desarrollo de Vite.
# Sin Docker (backend en el puerto 3000):
VITE_API_PROXY_TARGET=http://localhost:3000

# Con Docker Compose, el servicio frontend usa:
# VITE_API_PROXY_TARGET=http://backend:3000

# Opcional: prefijo de la API. Por defecto es /api/v1 (mismo origen).
# VITE_API_BASE_URL=/api/v1
